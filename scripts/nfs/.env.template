# -------------------------
# NFS CONFIG
# -------------------------
NFS_SERVER=10.123.20.99

# Format: "export:mountpoint"
NFS_MOUNTS=(
    "/volume1/docker:/docker"
)

NFS_OPTIONS="nfsvers=4,rw,noatime,hard,_netdev,nofail,x-systemd.automount,x-systemd.idle-timeout=0"

# -------------------------
# CIFS CONFIG
# -------------------------
CIFS_SERVER=10.123.20.99

# Format: "share:mountpoint"
CIFS_MOUNTS=(
    "media:/media"
)

# Root-only credentials file, written by mount.sh (not put in fstab)
CIFS_CREDENTIALS_FILE=/root/.smbServer
CIFS_USERNAME=""
CIFS_PASSWORD=""

# CIFS mount options (Synology-compatible)
CIFS_OPTIONS="vers=3.1.1,uid=1000,gid=1000,file_mode=0775,dir_mode=0775,_netdev,nofail,x-systemd.automount,x-systemd.idle-timeout=0"
